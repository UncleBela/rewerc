#!/bin/rc

fn fltr_cache_read {
    if(~ $werc_readonly yes) content_read $*
    if not cat $*
}

fn fltr_cache {
    a=()
    tmpf=()

    proc=$1
    shift

    if(~ $#* 0) {
        tmpf=$TMPDIR/fmttmp.$pid
        f=$tmpf
        score=`{{tee $tmpf || exit 1} | sha1sum}
    }
    if not {
        f=$1
        if(~ $f */) {
            score=`{du -an $f | sha1sum || exit 1} # XXX using -n(bytes) instead of -t(lastmod) because sitemap proc touches files in tree.
            a=$f
            f=/dev/null
        }
        if not {
            score=`{fltr_cache_read $f | sha1sum || exit 1}
            score=$score(1)
        }
    }
    cachedir=$TMPDIR/fltr_cache/$score
    mkdir -p $cachedir >[2]/dev/null

    if(test -s $cachedir/$proc)
        cat $cachedir/$proc
    if not
        if({
            if(~ $f /dev/null || ~ $f $tmpf) cat $f
            if not fltr_cache_read $f
        } | $proc $a | tee $cachedir/$pid)
            mv $cachedir/$pid $cachedir/$proc

    rm $tmpf $cachedir/$pid >[2]/dev/null &
}
