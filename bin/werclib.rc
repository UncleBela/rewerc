	case S;	tz=-0600
	case SAMT;	tz=+0400
	case SAST;	tz=+0200
	case SBT;	tz=+1100
	case SCT;	tz=+0400
	case SGT;	tz=+0800
	case SRT;	tz=-0300
	case SST;	tz=-1100
	case T;	tz=-0700
	case TAHT;	tz=-1000
	case TFT;	tz=+0500
	case TJT;	tz=+0500
	case TKT;	tz=-1000
	case TLT;	tz=+0900
	case TMT;	tz=+0500
	case TVT;	tz=+1200
	case U;	tz=-0800
	case ULAT;	tz=+0800
	case UYST;	tz=-0200
	case UYT;	tz=-0300
