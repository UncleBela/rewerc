	case WDT;	tz=+0900
	case WEST;	tz=+0100
	case WET;	tz=+0000
	case WFT;	tz=+1200
	case WGST;	tz=-0200
	case WGT;	tz=-0300
	case WIB;	tz=+0700
	case WIT;	tz=+0900
	case WITA;	tz=+0800
	case WST;	tz=+0800
	case WT;	tz=+0000
	case X;	tz=-1100
	case Y;	tz=-1200
	case YAKST;	tz=+1000
	case YAKT;	tz=+0900
	case YAPT;	tz=+1000
	case YEKST;	tz=+0600
	case YEKT;	tz=+0500
	case Z;	tz=+0000
	}
	echo $date(6)^-$mo-$da^T^$date(4)^$tz
}

