	case KUYT;	tz=+0400
	case L;	tz=+1100
	case LHDT;	tz=+1100
	case LHST;	tz=+1030
	case LINT;	tz=+1400
	case M;	tz=+1200
	case MAGST;	tz=+1200
	case MAGT;	tz=+1100
	case MART;	tz=-0930
