fn conf_enable_wercpaste {
	paste_url=$conf_wd
	if (~ $#paste_dir 0) { paste_dir=`{pwd} }
	conf_enable_app wercpaste
}

# Existing public text files use the ordinary read-only page/static handlers.
# The app and its configuration entry point are retained, without a submission UI.
fn wercpaste_init { status=() }
fn begforpaste { echo '<p>HTTP paste submission is unavailable.</p>' }
